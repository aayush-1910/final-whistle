# ============================================================
# Final Whistle — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is listed in .gitignore.
# NEVER put real values in this file — it IS committed.
# ============================================================

# Football data provider
API_FOOTBALL_KEY=replace_me          # api-sports.io (API-Football)
FOOTBALL_DATA_ORG_KEY=replace_me     # football-data.org — different service, different token

# Supabase — backend only (never expose service-role key to frontend)
SUPABASE_URL=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_ANON_KEY=replace_me
SUPABASE_DB_PASSWORD=replace_me

# Application
APP_ENV=development
LOG_LEVEL=INFO
