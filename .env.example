# ============================================================
# Final Whistle — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is listed in .gitignore.
# NEVER put real values in this file — it IS committed.
# ============================================================

# ---- Required ------------------------------------------------
FOOTBALL_DATA_ORG_KEY=replace_me     # football-data.org token (data imports)

# Database: EITHER a full connection string ...
#   Locally the direct host works (IPv6). Servers and GitHub Actions usually need the
#   Supabase "Session pooler" string (IPv4): Supabase dashboard -> Connect.
DATABASE_URL=
# ... OR the project URL + database password (direct IPv6 host is derived from it)
SUPABASE_URL=replace_me
SUPABASE_DB_PASSWORD=replace_me

# ---- Optional ------------------------------------------------
APP_ENV=development                  # production on servers
LOG_LEVEL=INFO
LOG_FORMAT=text                      # json on servers (one JSON object per log line)
# Browser origins allowed to call the API (comma-separated), e.g. your Vercel URL.
CORS_ORIGINS=http://localhost:5173

# Not used by any code path; do NOT give these to production hosts.
API_FOOTBALL_KEY=replace_me          # API-Football (evaluated and rejected, OD-001)
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_ANON_KEY=replace_me
